{
  "identifier": "default",
  "description": "Default capability allowing the frontend to subscribe to core event streams.",
  "platforms": ["linux", "macOS", "windows"],
  "windows": ["main"],
  "webviews": ["main"],
  "urls": [
    "local://*",
    "http://localhost:1420/*",
    "tauri://localhost/*"
  ],
  "permissions": [
    { "identifier": "core:event:allow-listen", "scopes": [
      "actor-*",
      "app-*",
      "stage-*",
      "batch-*"
    ] },
    "core:event:default"
  ]
}
